# Local emulator settings for capstone.cloud-expedition-journal.
#
#   source capstones/cloud-expedition-journal/emulator.env
#
# Every value here is a published emulator default, not a credential. Azurite's
# development account, the Event Hubs emulator's fixed connection string, and the
# Cosmos emulator's well-known key are documented by Microsoft and are useless
# outside your own machine. They are the same well-known values the lesson
# companions and the management labs use, and they are the only key-shaped
# strings anywhere in this course.
#
# A live run uses none of them: it authenticates with Microsoft Entra ID and
# refuses to start while a key, connection string, or SAS token is in the
# environment — including these. Open a fresh shell before a live run, or unset
# them explicitly. See README.md#run-it-against-live-azure.

export AZURITE_CONNECTION_STRING="UseDevelopmentStorage=true"

export EVENTHUBS_EMULATOR_CONNECTION_STRING="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"

export COSMOS_EMULATOR_ENDPOINT="https://localhost:8081"
export COSMOS_EMULATOR_KEY="C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw=="

# Anything other than `live` selects the emulator stack.
export EXPEDITION_ENVIRONMENT="emulator"
