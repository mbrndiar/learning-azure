<Solution>
  <!--
    Every lesson companion and exercise project in the built curriculum, plus the
    shared offline test doubles. The course verifier is repository automation
    rather than course content, so it lives under its own solution folder.

    Exercise test projects default to the reference implementation and select the
    learner tree with -p:Implementation=starter, so a repository-wide
    `dotnet test` is a health signal rather than an expected failure. The applied
    project follows the same rule with -p:ImplementationRoot, which is declared
    repository-relative so the command matches the manifest's starter_root.
  -->
  <Folder Name="/support/">
    <Project Path="support/AzureFakes/AzureFakes.csproj" />
  </Folder>
  <Folder Name="/lessons/">
